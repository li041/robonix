# Board-side environment for the full-stack `rbnx boot`. Source it first:
#
#   cd /root/robonix/examples/webots-aibox
#   . ./boot.env
#   rbnx build -f robonix_manifest.yaml
#   rbnx boot -f robonix_manifest.yaml --no-update-check -v
#
# The board is a Zenoh client of the router inside the sim container, so the
# ROS data-plane wiring (rmw_zenoh, session config, advertise host) comes
# from the same env file the split deployment uses. VLM credentials stay on
# the board; pilot fails fast if any of the three is missing.

# Debug binaries built on the board (rbnx, robonix-atlas, ...).
export PATH="/root/robonix/target/debug:$PATH"

set -a
[ -f /root/robonix/run/webots-ubuntu.env ] && . /root/robonix/run/webots-ubuntu.env
[ -f /root/robonix/run/vlm.env ] && . /root/robonix/run/vlm.env
set +a

# Native service builds (mapping/nav2 jetson-native) verify and use the
# board's ROS 2; the split deployment's manual flow sources this by hand.
[ -f /opt/ros/humble/setup.bash ] && . /opt/ros/humble/setup.bash

# Scene reads the NPU model paths when rbnx initializes the service.
export ROBONIX_SCENE_FORCE=native
export SCENE_WEB_HOST=0.0.0.0
# No CUDA on the RK1828: the native build installs CPU-only torch instead of
# probing for a CUDA driver, and DualMap pins its torch-side device to cpu.
# The NPU graphs are unaffected — they run via rknn either way. On a CUDA
# machine this would force CPU, so don't copy it into other deployments.
export SCENE_CG_FORCE_CPU=1
export SCENE_DUALMAP_NPU_DIR=/root/robonix/dualmap/model/npu
export SCENE_DUALMAP_CLIP_WEIGHTS=/root/weights/clip/ViT-B-32.pt
export SCENE_DUALMAP_ROOT=/opt/dualmap
export SCENE_DUALMAP_CLASSES=/root/robonix/dualmap/config/class_list/scene_eval_classes.txt
